{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "governance",
    "readiness",
    "local_backup",
    "central_backup",
    "policy",
    "restore",
    "retention",
    "audit",
    "dependencies",
    "recovery_testing",
    "blockers",
    "recommended_next_phases",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "mode",
        "central_backup_ready",
        "shared_restore_ready",
        "team_enforcement_ready",
        "server_required",
        "server_opt_in",
        "cloud_sync"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "central_backup_ready": {
          "type": "boolean"
        },
        "shared_restore_ready": {
          "type": "boolean"
        },
        "team_enforcement_ready": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "overall_status",
        "implemented_prerequisites",
        "missing_prerequisites",
        "blocking_count",
        "safe_to_keep_local_cli",
        "safe_to_use_local_backup_restore",
        "safe_to_enable_central_backup",
        "safe_to_enable_shared_restore"
      ],
      "properties": {
        "overall_status": {
          "type": "string"
        },
        "implemented_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_count": {
          "type": "integer"
        },
        "safe_to_keep_local_cli": {
          "type": "boolean"
        },
        "safe_to_use_local_backup_restore": {
          "type": "boolean"
        },
        "safe_to_enable_central_backup": {
          "type": "boolean"
        },
        "safe_to_enable_shared_restore": {
          "type": "boolean"
        }
      }
    },
    "local_backup": {
      "type": "object",
      "additionalProperties": true
    },
    "central_backup": {
      "type": "object",
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": true
    },
    "restore": {
      "type": "object",
      "additionalProperties": true
    },
    "retention": {
      "type": "object",
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "additionalProperties": true
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": true
    },
    "recovery_testing": {
      "type": "object",
      "additionalProperties": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "severity",
          "category",
          "description",
          "required_before"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required_before": {
            "type": "string"
          }
        }
      }
    },
    "recommended_next_phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "config_path",
        "local_first",
        "privacy_first",
        "server_opt_in",
        "cloud_sync",
        "server_required",
        "business_commands_instrumented",
        "automatic_backup_policy_enforcement",
        "v2_retrieval_core_changed"
      ],
      "properties": {
        "config_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_first": {
          "type": "boolean"
        },
        "privacy_first": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "business_commands_instrumented": {
          "type": "boolean"
        },
        "automatic_backup_policy_enforcement": {
          "type": "boolean"
        },
        "v2_retrieval_core_changed": {
          "type": "boolean"
        }
      }
    }
  }
}
