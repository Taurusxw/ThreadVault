{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "governance",
    "readiness",
    "capabilities",
    "command_categories",
    "blockers",
    "recommended_next_phases",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "mode",
        "team_enforcement_ready",
        "current_permissions_enforced",
        "server_required",
        "server_available",
        "cloud_sync"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "team_enforcement_ready": {
          "type": "boolean"
        },
        "current_permissions_enforced": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "server_available": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "overall_status",
        "implemented_prerequisites",
        "missing_prerequisites",
        "blocking_count",
        "safe_to_keep_local_cli",
        "safe_to_enable_team_enforcement"
      ],
      "properties": {
        "overall_status": {
          "type": "string"
        },
        "implemented_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_count": {
          "type": "integer"
        },
        "safe_to_keep_local_cli": {
          "type": "boolean"
        },
        "safe_to_enable_team_enforcement": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "object"
    },
    "command_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "description",
          "commands",
          "audit_required",
          "preflight_available",
          "dry_run_available",
          "automatic_preflight",
          "automatic_audit",
          "ready_for_team_enforcement",
          "recommended_next_phase"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audit_required": {
            "type": "boolean"
          },
          "preflight_available": {
            "type": "boolean"
          },
          "dry_run_available": {
            "type": "boolean"
          },
          "automatic_preflight": {
            "type": "boolean"
          },
          "automatic_audit": {
            "type": "boolean"
          },
          "ready_for_team_enforcement": {
            "type": "boolean"
          },
          "recommended_next_phase": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "severity",
          "description",
          "required_before"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required_before": {
            "type": "string"
          }
        }
      }
    },
    "recommended_next_phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "config_path",
        "local_first",
        "privacy_first",
        "server_opt_in",
        "external_model_calls",
        "business_commands_instrumented",
        "automatic_audit_now",
        "v2_retrieval_core_changed",
        "inventory_command_count"
      ],
      "properties": {
        "config_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_first": {
          "type": "boolean"
        },
        "privacy_first": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "external_model_calls": {
          "type": "boolean"
        },
        "business_commands_instrumented": {
          "type": "boolean"
        },
        "automatic_audit_now": {
          "type": "boolean"
        },
        "v2_retrieval_core_changed": {
          "type": "boolean"
        },
        "inventory_command_count": {
          "type": "integer"
        }
      }
    }
  }
}
