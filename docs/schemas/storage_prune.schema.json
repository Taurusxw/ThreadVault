{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ok",
    "applied",
    "db_path",
    "cold_root",
    "referenced_blobs",
    "reclaimable_bytes"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "applied": {
      "type": "boolean"
    },
    "db_path": {
      "type": "string"
    },
    "cold_root": {
      "type": "string"
    },
    "referenced_blobs": {
      "type": "integer"
    },
    "unreferenced_metadata": {
      "type": "integer"
    },
    "orphan_files": {
      "type": "integer"
    },
    "reclaimable_bytes": {
      "type": "integer"
    }
  }
}
