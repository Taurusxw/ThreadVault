{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "request",
    "governance",
    "identity_provider",
    "actor",
    "binding",
    "role_mapping",
    "request_attribution",
    "audit",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "actor",
        "command",
        "operation",
        "target_type",
        "target_id",
        "client_id",
        "audit_log"
      ],
      "properties": {
        "actor": {
          "type": "string"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "audit_log": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "mode",
        "identity_binding_ready",
        "team_enforcement_ready",
        "server_required",
        "server_opt_in",
        "cloud_sync"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "identity_binding_ready": {
          "type": "boolean"
        },
        "team_enforcement_ready": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        }
      }
    },
    "identity_provider": {
      "type": "object",
      "additionalProperties": true
    },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "configured",
        "display",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "configured": {
          "type": "boolean"
        },
        "display": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "bound",
        "status",
        "failure_reason",
        "local_static_binding",
        "sufficient_for_local_governance",
        "sufficient_for_shared_enforcement"
      ],
      "properties": {
        "bound": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_static_binding": {
          "type": "boolean"
        },
        "sufficient_for_local_governance": {
          "type": "boolean"
        },
        "sufficient_for_shared_enforcement": {
          "type": "boolean"
        }
      }
    },
    "role_mapping": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "roles",
        "configured_roles",
        "invalid_roles",
        "supported_roles",
        "role_mapping_ready",
        "central_policy_role_resolution_ready"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configured_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalid_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role_mapping_ready": {
          "type": "boolean"
        },
        "central_policy_role_resolution_ready": {
          "type": "boolean"
        }
      }
    },
    "request_attribution": {
      "type": "object",
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "written",
        "record",
        "log",
        "authenticated_actor_provenance",
        "local_actor_binding_evidence"
      ],
      "properties": {
        "written": {
          "type": "boolean"
        },
        "record": {
          "type": [
            "object",
            "null"
          ]
        },
        "log": {
          "type": [
            "object",
            "null"
          ]
        },
        "authenticated_actor_provenance": {
          "type": "boolean"
        },
        "local_actor_binding_evidence": {
          "type": "boolean"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "config_path",
        "configured_actor_count",
        "local_first",
        "privacy_first",
        "server_required",
        "cloud_sync",
        "external_model_calls",
        "v2_retrieval_core_changed"
      ],
      "properties": {
        "config_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "configured_actor_count": {
          "type": "integer"
        },
        "local_first": {
          "type": "boolean"
        },
        "privacy_first": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        },
        "external_model_calls": {
          "type": "boolean"
        },
        "v2_retrieval_core_changed": {
          "type": "boolean"
        }
      }
    }
  }
}
