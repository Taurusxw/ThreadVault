{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "governance",
    "commands",
    "summary",
    "recommendations",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "mode",
        "enforcement_enabled",
        "server_required",
        "cloud_sync"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "enforcement_enabled": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "command",
          "operation",
          "access_level",
          "audit_required",
          "current_state",
          "future_phase",
          "notes"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "access_level": {
            "type": "string"
          },
          "audit_required": {
            "type": "boolean"
          },
          "current_state": {
            "type": "object"
          },
          "future_phase": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "command_count",
        "audit_required_count",
        "by_access_level"
      ],
      "properties": {
        "command_count": {
          "type": "integer"
        },
        "audit_required_count": {
          "type": "integer"
        },
        "by_access_level": {
          "type": "object"
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "inventory_source",
        "v2_retrieval_core_changed",
        "permissions_enforced_now",
        "automatic_audit_now"
      ],
      "properties": {
        "inventory_source": {
          "type": "string"
        },
        "v2_retrieval_core_changed": {
          "type": "boolean"
        },
        "permissions_enforced_now": {
          "type": "boolean"
        },
        "automatic_audit_now": {
          "type": "boolean"
        }
      }
    }
  }
}
