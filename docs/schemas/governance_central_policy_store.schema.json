{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "request",
    "governance",
    "store",
    "policy",
    "validation",
    "provenance",
    "actor_resolution",
    "operation_resolution",
    "enforcement",
    "blockers",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "mode",
        "central_policy_ready",
        "team_enforcement_ready",
        "current_permissions_enforced",
        "server_required",
        "server_opt_in",
        "cloud_sync"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "central_policy_ready": {
          "type": "boolean"
        },
        "team_enforcement_ready": {
          "type": "boolean"
        },
        "current_permissions_enforced": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "available",
        "path",
        "exists",
        "shared_persistence",
        "server_required",
        "cloud_sync"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "exists": {
          "type": "boolean"
        },
        "shared_persistence": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "valid",
        "contract_version",
        "expected_contract_version",
        "policy_id",
        "version",
        "role_count",
        "actor_count",
        "source_hash"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "contract_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_contract_version": {
          "type": "string"
        },
        "policy_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_count": {
          "type": "integer"
        },
        "actor_count": {
          "type": "integer"
        },
        "source_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ok",
        "errors",
        "warnings",
        "known_roles",
        "known_access_levels",
        "known_operations"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "array"
        },
        "warnings": {
          "type": "array"
        },
        "known_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_access_levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "actor_resolution": {
      "type": "object",
      "additionalProperties": true
    },
    "operation_resolution": {
      "type": "object",
      "additionalProperties": true
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "would_allow",
        "would_block",
        "automatic_business_enforcement",
        "shared_enforcement_ready",
        "status"
      ],
      "properties": {
        "would_allow": {
          "type": "boolean"
        },
        "would_block": {
          "type": "boolean"
        },
        "automatic_business_enforcement": {
          "type": "boolean"
        },
        "shared_enforcement_ready": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "blockers": {
      "type": "array"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "config_path",
        "local_first",
        "privacy_first",
        "server_required",
        "server_opt_in",
        "cloud_sync",
        "v2_retrieval_core_changed",
        "business_commands_instrumented",
        "automatic_policy_enforcement"
      ],
      "properties": {
        "config_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_first": {
          "type": "boolean"
        },
        "privacy_first": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        },
        "v2_retrieval_core_changed": {
          "type": "boolean"
        },
        "business_commands_instrumented": {
          "type": "boolean"
        },
        "automatic_policy_enforcement": {
          "type": "boolean"
        }
      }
    }
  }
}
