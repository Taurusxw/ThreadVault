{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "request",
    "governance",
    "decision",
    "audit",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "operation",
        "role",
        "audit_log",
        "actor",
        "target_type",
        "target_id"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "audit_log": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "mode",
        "permissions_enforced"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "permissions_enforced": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "allowed",
        "would_allow",
        "enforced",
        "status",
        "required_access",
        "role_access_levels",
        "reasons"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "would_allow": {
          "type": "boolean"
        },
        "enforced": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "required_access": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_access_levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "audit": {
      "type": "object"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "known_operation",
        "known_role",
        "server_required",
        "external_model_calls"
      ],
      "properties": {
        "known_operation": {
          "type": "boolean"
        },
        "known_role": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "external_model_calls": {
          "type": "boolean"
        }
      }
    }
  }
}
