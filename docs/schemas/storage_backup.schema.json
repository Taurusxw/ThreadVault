  "type": "object",
  "additionalProperties": true,
  "required": [
    "ok",
    "profile",
    "database"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "profile": {
      "type": "string"
    },
    "database": {
      "type": "object"
    },
    "cold": {
      "type": "object"
    },
    "forensic_files": {
      "type": "integer"
    },
    "manifest": {
      "type": "string"
    }
  }
}
