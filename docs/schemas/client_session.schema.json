{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "request",
    "session",
    "summary",
    "events",
    "actions",
    "privacy",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "session_id",
        "event_limit",
        "max_chars",
        "local_debug"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "event_limit": {
          "type": "integer"
        },
        "max_chars": {
          "type": "integer"
        },
        "local_debug": {
          "type": "boolean"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "session_id",
        "parent_session_id",
        "cwd",
        "source_kind",
        "model_provider",
        "first_seen_at",
        "updated_at",
        "archived",
        "event_count",
        "warning_count"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "parent_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_kind": {
          "type": "string"
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_seen_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "event_count": {
          "type": "integer"
        },
        "warning_count": {
          "type": "integer"
        },
        "raw_path": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "session_id",
        "topic",
        "evidence_event_ids",
        "evidence_coverage"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "user_goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_steps": {
          "type": "array"
        },
        "key_commands": {
          "type": "array"
        },
        "files": {
          "type": "array"
        },
        "problems": {
          "type": "array"
        },
        "next_steps": {
          "type": "array"
        },
        "evidence_event_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "evidence_coverage": {
          "type": "object"
        },
        "missing_evidence_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "event_id",
          "turn_id",
          "turn_index",
          "timestamp",
          "top_type",
          "sub_type",
          "role",
          "tool_name",
          "text_preview",
          "truncated"
        ],
        "properties": {
          "event_id": {
            "type": "integer"
          },
          "turn_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "turn_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "timestamp": {
            "type": [
              "string",
              "null"
            ]
          },
          "top_type": {
            "type": "string"
          },
          "sub_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "text_preview": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          },
          "file_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "line_no": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "actions": {
      "type": "object"
    },
    "privacy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "local_first",
        "raw_paths_included",
        "event_file_paths_included",
        "raw_transcript_included",
        "external_model_calls"
      ],
      "properties": {
        "local_first": {
          "type": "boolean"
        },
        "raw_paths_included": {
          "type": "boolean"
        },
        "event_file_paths_included": {
          "type": "boolean"
        },
        "raw_transcript_included": {
          "type": "boolean"
        },
        "external_model_calls": {
          "type": "boolean"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "event_count",
        "events_returned",
        "events_truncated",
        "summary_evidence_count",
        "server_required"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "event_count": {
          "type": "integer"
        },
        "events_returned": {
          "type": "integer"
        },
        "events_truncated": {
          "type": "integer"
        },
        "summary_evidence_count": {
          "type": "integer"
        },
        "server_required": {
          "type": "boolean"
        }
      }
    }
  }
}
