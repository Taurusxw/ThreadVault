{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "status",
    "ok",
    "governance",
    "checks",
    "summary",
    "criteria",
    "gap_audit",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "server_required",
        "server_opt_in",
        "cloud_sync",
        "team_capabilities_opt_in",
        "production_shared_enforcement_claimed"
      ],
      "properties": {
        "server_required": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        },
        "team_capabilities_opt_in": {
          "type": "boolean"
        },
        "production_shared_enforcement_claimed": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "category",
          "ok",
          "required",
          "message",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "required_check_count",
        "passed_check_count",
        "failed_check_count",
        "criteria_count",
        "criteria_satisfied_count"
      ],
      "properties": {
        "required_check_count": {
          "type": "integer"
        },
        "passed_check_count": {
          "type": "integer"
        },
        "failed_check_count": {
          "type": "integer"
        },
        "criteria_count": {
          "type": "integer"
        },
        "criteria_satisfied_count": {
          "type": "integer"
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "status",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gap_audit": {
      "type": "object",
      "additionalProperties": true
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
