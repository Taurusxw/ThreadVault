{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "dir",
    "reports",
    "warnings",
    "latest"
  ],
  "properties": {
    "dir": {
      "type": "string"
    },
    "reports": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "latest": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
