{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "ok",
    "action",
    "status",
    "confirm",
    "safety"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "confirm": {
      "type": "boolean"
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {},
    "safety": {
      "type": "object"
    },
    "available_actions": {
      "type": "array"
    }
  }
}
