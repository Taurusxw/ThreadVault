{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "governance",
    "completion",
    "milestones",
    "acceptance_criteria",
    "implemented_capabilities",
    "remaining_gaps",
    "blockers",
    "recommended_next_phases",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "mode",
        "server_required",
        "server_opt_in",
        "cloud_sync",
        "team_capabilities_opt_in"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "server_required": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        },
        "team_capabilities_opt_in": {
          "type": "boolean"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "overall_status",
        "v3_complete",
        "accepted_phase_count",
        "current_phase",
        "remaining_gap_count",
        "blocking_count",
        "safe_to_keep_local_cli",
        "safe_to_claim_shared_deployment_ready",
        "safe_to_run_final_v3_acceptance"
      ],
      "properties": {
        "overall_status": {
          "type": "string"
        },
        "v3_complete": {
          "type": "boolean"
        },
        "accepted_phase_count": {
          "type": "integer"
        },
        "current_phase": {
          "type": "string"
        },
        "remaining_gap_count": {
          "type": "integer"
        },
        "blocking_count": {
          "type": "integer"
        },
        "safe_to_keep_local_cli": {
          "type": "boolean"
        },
        "safe_to_claim_shared_deployment_ready": {
          "type": "boolean"
        },
        "safe_to_run_final_v3_acceptance": {
          "type": "boolean"
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "version",
          "title",
          "status",
          "phase_refs"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "phase_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "criterion",
          "status",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "implemented_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "status",
          "description",
          "recommended_phase"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "recommended_phase": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "severity",
          "category",
          "description",
          "required_before"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required_before": {
            "type": "string"
          }
        }
      }
    },
    "recommended_next_phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "config_path",
        "local_first",
        "privacy_first",
        "server_opt_in",
        "cloud_sync",
        "server_required",
        "v2_retrieval_accepted",
        "v2_retrieval_core_changed",
        "deep_research_report_retired"
      ],
      "properties": {
        "config_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_first": {
          "type": "boolean"
        },
        "privacy_first": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "v2_retrieval_accepted": {
          "type": "boolean"
        },
        "v2_retrieval_core_changed": {
          "type": "boolean"
        },
        "deep_research_report_retired": {
          "type": "boolean"
        }
      }
    }
  }
}
