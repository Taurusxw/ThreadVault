{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "request",
    "governance",
    "store",
    "append",
    "query",
    "verification",
    "records",
    "warnings",
    "errors",
    "blockers",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "mode",
        "centralized_audit_ready",
        "team_enforcement_ready",
        "server_required",
        "server_opt_in",
        "cloud_sync"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "centralized_audit_ready": {
          "type": "boolean"
        },
        "team_enforcement_ready": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "available",
        "path",
        "exists",
        "local_file_store",
        "shared_persistence",
        "server_required",
        "cloud_sync"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "exists": {
          "type": "boolean"
        },
        "local_file_store": {
          "type": "boolean"
        },
        "shared_persistence": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        }
      }
    },
    "append": {
      "type": "object",
      "additionalProperties": true
    },
    "query": {
      "type": "object",
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ok",
        "record_count",
        "valid_record_count",
        "warning_count",
        "errors",
        "append_only",
        "hash_chain_valid",
        "last_hash"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "record_count": {
          "type": "integer"
        },
        "valid_record_count": {
          "type": "integer"
        },
        "warning_count": {
          "type": "integer"
        },
        "errors": {
          "type": "array"
        },
        "append_only": {
          "type": "boolean"
        },
        "hash_chain_valid": {
          "type": "boolean"
        },
        "last_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "config_path",
        "local_first",
        "privacy_first",
        "server_required",
        "server_opt_in",
        "cloud_sync",
        "append_only_integrity",
        "record_hashing",
        "signature_or_seal",
        "automatic_business_audit",
        "v2_retrieval_core_changed"
      ],
      "properties": {
        "config_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_first": {
          "type": "boolean"
        },
        "privacy_first": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "server_opt_in": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        },
        "append_only_integrity": {
          "type": "boolean"
        },
        "record_hashing": {
          "type": "boolean"
        },
        "signature_or_seal": {
          "type": "boolean"
        },
        "automatic_business_audit": {
          "type": "boolean"
        },
        "v2_retrieval_core_changed": {
          "type": "boolean"
        }
      }
    }
  }
}
