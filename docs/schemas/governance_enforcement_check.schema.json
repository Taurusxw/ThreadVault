{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "request",
    "command_policy",
    "permission",
    "enforcement",
    "audit",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "command",
        "role",
        "audit_log",
        "actor",
        "target_type",
        "target_id"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "audit_log": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "command_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "known",
        "command",
        "operation",
        "access_level",
        "audit_required",
        "future_phase",
        "notes"
      ],
      "properties": {
        "known": {
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "audit_required": {
          "type": "boolean"
        },
        "future_phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "allowed",
        "would_allow",
        "enforced",
        "status",
        "required_access",
        "role_access_levels",
        "reasons"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "would_allow": {
          "type": "boolean"
        },
        "enforced": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "required_access": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_access_levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "dry_run",
        "current_enforced",
        "current_automatic_preflight",
        "current_automatic_audit",
        "future_enforcement_recommended",
        "would_block_if_enforced",
        "status",
        "reasons"
      ],
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "current_enforced": {
          "type": "boolean"
        },
        "current_automatic_preflight": {
          "type": "boolean"
        },
        "current_automatic_audit": {
          "type": "boolean"
        },
        "future_enforcement_recommended": {
          "type": "boolean"
        },
        "would_block_if_enforced": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "audit": {
      "type": "object"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "known_command",
        "inventory_source",
        "governance_enabled",
        "server_required",
        "cloud_sync",
        "external_model_calls",
        "business_command_executed",
        "v2_retrieval_core_changed"
      ],
      "properties": {
        "known_command": {
          "type": "boolean"
        },
        "inventory_source": {
          "type": "string"
        },
        "governance_enabled": {
          "type": "boolean"
        },
        "server_required": {
          "type": "boolean"
        },
        "cloud_sync": {
          "type": "boolean"
        },
        "external_model_calls": {
          "type": "boolean"
        },
        "business_command_executed": {
          "type": "boolean"
        },
        "v2_retrieval_core_changed": {
          "type": "boolean"
        }
      }
    }
  }
}
